# ── Voice Biomarker Platform v2 – Environment Variables ─────────────────────
# Copy this file to .env and fill in the values.

# Environment
VB2_DEBUG=false
VB2_ENVIRONMENT=development
VB2_LOG_LEVEL=INFO

# Paths
VB2_BASE_DIR=./

# Audio
VB2_AUDIO__TARGET_SR=16000
VB2_AUDIO__MAX_DURATION=30
VB2_AUDIO__MIN_DURATION=2
VB2_AUDIO__QUALITY_THRESHOLD=0.3

# Model
VB2_MODEL__MODEL_TYPE=xgboost
VB2_MODEL__NUM_FEATURES=50
VB2_MODEL__USE_DEEP_MODEL=false
VB2_MODEL__CHECKPOINT_DIR=models/checkpoints

# Training
VB2_TRAINING__BATCH_SIZE=32
VB2_TRAINING__EPOCHS=100
VB2_TRAINING__LEARNING_RATE=0.001
VB2_TRAINING__VALIDATION_SPLIT=0.2
VB2_TRAINING__EARLY_STOPPING_PATIENCE=10

# API
VB2_API__HOST=0.0.0.0
VB2_API__PORT=8000
VB2_API__MAX_UPLOAD_SIZE=52428800
VB2_API__ALLOWED_EXTENSIONS=["wav","mp3","ogg","flac","m4a"]

# Explainability
VB2_EXPLAINABILITY__USE_SHAP=true
VB2_EXPLAINABILITY__USE_LIME=true
VB2_EXPLAINABILITY__NUM_FEATURES=10

# Data
VB2_DATA__SYNTHETIC_SAMPLES=1000
VB2_DATA__DATA_DIR=data

# Secrets / External services
VB2_SECRET_KEY=change-me-to-a-random-secret
VB2_REDIS_URL=redis://localhost:6379/0
